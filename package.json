{
  "name": "ollama-agent-cli",
  "version": "1.0.0",
  "description": "Local AI Coding Agent powered by Ollama — terminal-based AI assistant that reads, writes, edits, and manages your projects.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "oai": "bin/ollama-agent.js",
    "ollama-agent": "bin/ollama-agent.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/ollama-agent.js",
    "dev": "node --watch bin/ollama-agent.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/integration",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "ollama",
    "ai",
    "cli",
    "coding-agent",
    "llm",
    "terminal",
    "code-generation",
    "local-ai",
    "developer-tools"
  ],
  "author": "OllamaAgent Contributors",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "ora": "^8.1.0",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0"
  },
  "files": [
    "bin/",
    "src/",
    "plugins/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ollama-agent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ollama-agent-cli/issues"
  },
  "homepage": "https://github.com/your-org/ollama-agent-cli#readme"
}
